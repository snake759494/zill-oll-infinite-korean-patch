{"id": 484, "ko": "한손검"}
{"id": 485, "ko": "양손검"}
{"id": 486, "ko": "장병기"}
{"id": 487, "ko": "도끼"}
{"id": 488, "ko": "단검"}
{"id": 489, "ko": "활"}
{"id": 490, "ko": "권갑"}
{"id": 491, "ko": "방패"}
{"id": 492, "ko": "천 방어구"}
{"id": 493, "ko": "가슴받이"}
{"id": 494, "ko": "몸통 갑옷"}
{"id": 495, "ko": "전신 갑옷"}
{"id": 496, "ko": "액세서리"}
{"id": 497, "ko": "봉인되어 있습니다"}
{"id": 498, "ko": "예"}
{"id": 499, "ko": "아니요"}
{"id": 500, "ko": "이벤트"}
{"id": 501, "ko": "기사의 무기라면 역시 한손검이지.\n게다가 이게 제일 쓰기 편하거든."}
{"id": 502, "ko": "거절하겠네. 내 경험상 도끼야말로\n전장에서 가장 쓸모 있는 무기거든."}
{"id": 503, "ko": "에러 메시지 한손검"}
{"id": 504, "ko": "불타는 사나이는 주먹으로 상대와\n대화하는 법이라고, 젠장!"}
{"id": 505, "ko": "아, 안 돼, 그렇게 큰 무기는.\n나는 단검이면 되니까…."}
{"id": 506, "ko": "내 활 솜씨를 믿지 못하는 건가?"}
{"id": 507, "ko": "제가 무기를 들고 싸우라고요?\n무기 같은 건 써 본 적도 없어요."}
{"id": 508, "ko": "에러 메시지 낫"}
{"id": 509, "ko": "누나, 몰랐어?\n나 창 다루는 솜씨는\n꽤 대단하다고."}
{"id": 510, "ko": "어머, 무기 같은 건 없어도 괜찮아.\n나한텐 마법의 힘이 있으니까."}
{"id": 511, "ko": "양손검이 내 트레이드마크라서 말이야.\n다른 무기를 쓰면 가짜 취급받는다고."}
{"id": 512, "ko": "나는 싸움에 쓰려면 도끼가 최고라고\n생각하네. 다른 무기는 가벼워서 못써."}
{"id": 513, "ko": "콘스의 무기는 창이 최고라고\n할아버지가 그랬어."}
{"id": 514, "ko": "창으로는 안 되겠나?\n내게 어울리는 무기라고 생각하는데."}
{"id": 515, "ko": "이런 무기론 우아하게 싸울 수가 없잖아.\n왜 창은 안 된다는 거야!"}
{"id": 516, "ko": "오 노! 도끼로 해 주시오.\n사형… 안 되겠소이까?"}
{"id": 517, "ko": "그렇게 커다란 무기가 아니어도\n괜찮아. 단검으로도 싸울 수 있거든."}
{"id": 518, "ko": "에러 메시지… 한손검으로… 해라."}
{"id": 519, "ko": "내 검술은 이도류… 한손검이 아니면\n의미가 없다. 모르지는 않을 텐데."}
{"id": 520, "ko": "그런~!\n활 솜씨를 믿어 주지 않다니…\n나, 풀 죽어 버릴 거야."}
{"id": 521, "ko": "싸움에선 작은 어긋남이 목숨을 앗는다.\n그걸 모르는 자네는 아닐 테지."}
{"id": 522, "ko": "저희 일은 몸이 가볍지 않으면\n해낼 수가 없답니다.\n죄송합니다."}
{"id": 523, "ko": "밀정은 빠른 게 생명이야.\n무거운 건 장비하고 싶지 않아."}
{"id": 524, "ko": "이 녀석과는 오랜 인연이라서.\n손에서 놓을 마음이 안 드는군."}
{"id": 525, "ko": "하하, 안됐지만 이건 양보 못 해.\n이건 소중한 물건이거든."}
{"id": 526, "ko": "에러 메시지\n무, 무무… 무기를 들고 싸우다니,\n저, 저는 못 해요."}
{"id": 527, "ko": "에러 메시지\n창과 뿔은 비슷하다… 려나."}
{"id": 528, "ko": "에러 메시지!"}
{"id": 529, "ko": "에러 메시지 단검 손도끼"}
{"id": 530, "ko": "죄송해요.\n에러 메시지예요."}
{"id": 531, "ko": "단검 손도끼"}
{"id": 532, "ko": "에러 메시지\n로치나아아아아아아아아아!"}
{"id": 533, "ko": "에러 메시지\n푸시! 푸시!\n고니시키 밀어내기!"}
{"id": 534, "ko": "기사라면 전신 갑옷이지만…, 나한텐\n몸통 갑옷이 싸우기 편한 것 같아."}
{"id": 535, "ko": "전장에서 제일 무서운 건 빗나간 화살.\n전신 갑옷이 아니면 전력으로 못 싸워."}
{"id": 536, "ko": "천 방어구는 멋있어서 좋을지도!\n그래도 살찐 게 들통나려나?"}
{"id": 537, "ko": "불타는 사나이의 방어구는 몸통\n갑옷으로 정해져 있다고, 젠장!"}
{"id": 538, "ko": "미, 미안해. 나, 몸통 갑옷 말고는\n방어구가 싫거든."}
{"id": 539, "ko": "너무 이래라저래라 하지 말아 줘.\n나는 가슴받이 말고는 걸칠 생각이 없다."}
{"id": 540, "ko": "에러 메시지\n하하, 무거운 방어구는 어깨가 뭉쳐서요.\n저는 천 방어구면 충분합니다."}
{"id": 541, "ko": "에러 메시지\n가슴받이가 아니면 내\n아름다운 자태를 보여 줄 수 없잖아."}
{"id": 542, "ko": "누나, 나보고 이런 걸 장비하라고\n하는 거야? 몸통 갑옷으로 해 줘."}
{"id": 543, "ko": "에러 메시지\n어머, 나보고 갑옷을 입으라는 거야?\n나는 너랑 달리 두뇌 노동 전문이거든."}
{"id": 544, "ko": "모험자라면 몸통 갑옷을 걸쳐야 한다.\n내 명언이지. 멋지지?"}
{"id": 545, "ko": "나는 가슴받이 말고는 걸칠 생각 없어.\n할 말은 그것뿐이다."}
{"id": 546, "ko": "멍청한 놈!\n나는 몸통 갑옷밖에 못 입는다!"}
{"id": 547, "ko": "방어구는 가슴받이로 하라고\n할아버지가 그랬어."}
{"id": 548, "ko": "에러 메시지\n나는 전신 갑옷만 걸친다."}
{"id": 549, "ko": "정말, 왜 가슴받이는 안 되는 거야!\n이유를 설명해 봐, 이유를!"}
{"id": 550, "ko": "가슴받이는 브레스와 아머에 강하오!\n사형… 어떻소이까?"}
{"id": 551, "ko": "무, 무거워~. 천 방어구가 아니면\n너무 무거워서 못 싸워~."}
{"id": 552, "ko": "…갑옷은 싫어."}
{"id": 553, "ko": "유감이지만, 내 싸움 방식을 이해 못 한\n모양이군. 왜 몸통 갑옷인지를."}
{"id": 554, "ko": "에엣! 이걸 장비하라고?\n나, 가슴받이 아니면 싫은데."}
{"id": 555, "ko": "방어구는 전신 갑옷이 최고지.\n용병으로 전장에 나가 보면 싫어도\n알게 되는 법이야."}
{"id": 556, "ko": "방어력과 기동력.\n싸움에선 이 균형이 중요해.\n그래서 나는 몸통 갑옷을 쓰고 싶어."}
{"id": 557, "ko": "에러 메시지\n천 방어구"}
{"id": 558, "ko": "에러 메시지\n몸통 갑옷"}
{"id": 559, "ko": "에러 메시지."}
{"id": 560, "ko": "에러 메시지야.\n나는 이제 없어."}
{"id": 561, "ko": "미안해.\n이거 내가 아끼는 거야."}
{"id": 562, "ko": "이 녀석은 함께 전장을 누빈\n내 친구일세. 놓아줄 수는 없지."}
{"id": 563, "ko": "내 물건을 탐내다니….\n혹시 마니아인가? 꺄악!"}
{"id": 564, "ko": "내 장비는 내가 정한다고.\n알겠냐, 젠장!"}
{"id": 565, "ko": "그, 그런, 안 돼.\n소, 소중한 거… 란… 말이야."}
{"id": 566, "ko": "나에게도 좋고 싫음이 있다….\n그게 마음에 드는 거다."}
{"id": 567, "ko": "죄송하지만\n저는 지금 모습이 마음에 들어서…."}
{"id": 568, "ko": "나한테 제일 잘 어울리는 게\n이거란 말이야. 모르겠어?"}
{"id": 569, "ko": "아무리 누나 부탁이라도 이건\n내 거라고. 봐 달라고."}
{"id": 570, "ko": "이건 내가 아끼는 것 중 하나야.\n뺄 수는 없어."}
{"id": 571, "ko": "어이쿠, 이 녀석은 내 애장품\n이라서 말이야."}
{"id": 572, "ko": "이건 나의 전부…\n넘겨줄 수는 없다."}
{"id": 573, "ko": "멍청한 놈!\n내 애장품에 손대지 마라!"}
{"id": 574, "ko": "미안해. 나, 그거\n마음에 들거든."}
{"id": 575, "ko": "이보다 나은 물건을 나는 모르겠군."}
{"id": 576, "ko": "고귀한 이 몸의 물건을 너한테\n넘기라고! 농담하지 마!"}
{"id": 577, "ko": "사형, 그, 그것만은!\n소인, 더 정진할 테니 용서를!"}
{"id": 578, "ko": "음~ 있지. 그거 소중한 거\n거든. 그러니까 못 빼~"}
{"id": 579, "ko": "………못 넘겨."}
{"id": 580, "ko": "이건 나에게 양보할 수 없는 것…\n잃고 싶지 않다."}
{"id": 581, "ko": "에엣! 이걸 빼앗기면\n나 곤란한데. 그러니까 안 돼."}
{"id": 582, "ko": "곤란해요. 그건 연구에 필요한 물건\n이거든요."}
{"id": 583, "ko": "이건 내 소유물이다.\n내 마음대로 하겠다."}
{"id": 584, "ko": "이것만은 드릴 수 없습니다.\n다른 물건으로 해 주시겠습니까."}
{"id": 585, "ko": "인간 따위에게 지시받을 이유는 없다.\n내 물건에 손대지 마라."}
{"id": 586, "ko": "휘익! 내 물건을 탐내다니,\n당신 보는 눈 있네. 그래도 못 줘."}
{"id": 587, "ko": "죄송해요.\n이건 제가 아끼는 거예요."}
{"id": 588, "ko": "이건 뭔가 잘못됐구먼."}
{"id": 589, "ko": "그건 가져가지 말아 줘.\n내 애장품이거든."}
{"id": 590, "ko": "내 애용품을 탐내다니, 보는 눈은\n좋지만 그건 안 될 말이지."}
{"id": 591, "ko": "에러 메시지다.\n나는 이제 없으니까."}
{"id": 592, "ko": "에러 메시지다.\n나는 이제 없다."}
{"id": 593, "ko": "이걸 넘겨주는 건 너를 제 몫 하는\n자로 인정했을 때다. 아직 이르다."}
